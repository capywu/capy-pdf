{
  "name": "Capy PDF V7.0",
  "short_name": "Capy PDF",
  "description": "自用 PDF 標註工具",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#18181b",
  "theme_color": "#18181b",
  "lang": "zh-Hant",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
